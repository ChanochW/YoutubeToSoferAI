{
  "name": "youtube-to-soferai",
  "version": "1.1.0",
  "description": "Converts YouTube shiurim into readable documents.",
  "main": "index.js",
  "scripts": {
    "prepare:binaries": "node scripts/prepare-binaries.mjs",
    "build:bundle": "node scripts/build-bundle.mjs",
    "start:bundle": "node dist/app.cjs",
    "build:exe": "npm run build:bundle && node scripts/build-exe.mjs",
    "package:release": "npm run build:exe && node scripts/package-release.mjs",
    "dev": "tsx src/index.ts",
    "channel-to-csv": "tsx src/index.ts channel-to-csv \"https://www.youtube.com/@rabbialankimche491\" data/videos.csv",
    "download": "tsx src/index.ts download data/videos.csv",
    "download-failed": "tsx src/index.ts download data/failed-downloads.csv",
    "transcribe-local": "tsx src/index.ts transcribe-local data/videos.csv",
    "check-transcriptions": "tsx src/index.ts check-transcriptions",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@types/node": "^26.0.0",
    "axios": "^1.18.1",
    "cli-progress": "^3.12.0",
    "commander": "^15.0.0",
    "csv-parse": "^7.0.0",
    "docx": "^9.7.1",
    "dotenv": "^17.4.2",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static-installer": "^5.2.0",
    "fs-extra": "^11.3.5",
    "html-entities": "^2.6.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "youtube-dl-exec": "^3.1.8"
  },
  "devDependencies": {
    "@types/cli-progress": "^3.11.6",
    "@types/fs-extra": "^11.0.4",
    "esbuild": "^0.28.1",
    "postject": "^1.0.0-alpha.6"
  }
}
